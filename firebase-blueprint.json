{
  "entities": {
    "Vault": {
      "title": "Vault",
      "description": "Shared couple vacation savings vault with fixed completion target and two-member access control.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "destination": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "targetAmount": {
          "type": "number",
          "description": "Fixed completion goal in EUR."
        },
        "partnerAName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "partnerBName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "loveNote": {
          "type": "string",
          "maxLength": 240
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "memberUids": {
          "type": "array",
          "description": "Up to 2 authenticated partner UIDs."
        },
        "inviteCode": {
          "type": "string",
          "minLength": 8,
          "maxLength": 24,
          "pattern": "^[A-Z0-9]+$"
        },
        "joinedInviteCode": {
          "type": "string",
          "maxLength": 24
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "title",
        "destination",
        "targetAmount",
        "partnerAName",
        "partnerBName",
        "loveNote",
        "ownerUid",
        "memberUids",
        "inviteCode",
        "joinedInviteCode",
        "createdAt",
        "updatedAt"
      ]
    },
    "VaultInvite": {
      "title": "VaultInvite",
      "description": "Private secret-code lookup record allowing the second partner to join a shared vault.",
      "type": "object",
      "properties": {
        "inviteCode": {
          "type": "string",
          "minLength": 8,
          "maxLength": 24,
          "pattern": "^[A-Z0-9]+$"
        },
        "vaultId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "vaultTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "destination": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "partnerAName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "partnerBName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "inviteCode",
        "vaultId",
        "ownerUid",
        "vaultTitle",
        "destination",
        "partnerAName",
        "partnerBName",
        "createdAt"
      ]
    },
    "Contribution": {
      "title": "Contribution",
      "description": "Deposit funded strictly by external side activities or micro-savings.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "amount": {
          "type": "number"
        },
        "partnerKey": {
          "type": "string",
          "enum": ["A", "B"]
        },
        "partnerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "sourceTag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "note": {
          "type": "string",
          "maxLength": 200
        },
        "reactionHeart": {
          "type": "boolean"
        },
        "reactionToast": {
          "type": "boolean"
        },
        "reactionPlane": {
          "type": "boolean"
        },
        "reactionFire": {
          "type": "boolean"
        },
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "amount",
        "partnerKey",
        "partnerName",
        "sourceTag",
        "note",
        "reactionHeart",
        "reactionToast",
        "reactionPlane",
        "reactionFire",
        "authorUid",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/vaults/{vaultId}": {
      "schema": {
        "$ref": "#/entities/Vault"
      },
      "description": "Shared couple vacation savings vault document."
    },
    "/vaultInvites/{inviteCode}": {
      "schema": {
        "$ref": "#/entities/VaultInvite"
      },
      "description": "Private invite code lookup document for joining a vault."
    },
    "/vaults/{vaultId}/contributions/{contributionId}": {
      "schema": {
        "$ref": "#/entities/Contribution"
      },
      "description": "External-activity deposit records belonging to a vault."
    }
  }
}
