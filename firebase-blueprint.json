{
  "entities": {
    "Vault": {
      "title": "Vault",
      "description": "Single shared couple Africa trip savings vault with fixed completion target.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "destination": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "targetAmount": {
          "type": "number",
          "description": "Fixed completion goal in EUR."
        },
        "partnerAName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "partnerBName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "loveNote": {
          "type": "string",
          "maxLength": 240
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "title",
        "destination",
        "targetAmount",
        "partnerAName",
        "partnerBName",
        "loveNote",
        "createdAt",
        "updatedAt"
      ]
    },
    "Category": {
      "title": "Category",
      "description": "Customizable deposit category synced between both partners with archive and last-used support.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "archived": {
          "type": "boolean"
        },
        "lastUsedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Nullable timestamp of most recent deposit using this category."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "archived",
        "lastUsedAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "Contribution": {
      "title": "Contribution",
      "description": "Deposit funded strictly by external side activities.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "amount": {
          "type": "number"
        },
        "partnerKey": {
          "type": "string",
          "enum": ["A", "B"]
        },
        "partnerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "sourceTag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "categoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "note": {
          "type": "string",
          "maxLength": 200
        },
        "pendingPhysical": {
          "type": "boolean",
          "description": "True when already counted in the app total but still pending insertion into the physical home piggy bank."
        },
        "reactionHeart": {
          "type": "boolean"
        },
        "reactionToast": {
          "type": "boolean"
        },
        "reactionPlane": {
          "type": "boolean"
        },
        "reactionFire": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "amount",
        "partnerKey",
        "partnerName",
        "sourceTag",
        "note",
        "reactionHeart",
        "reactionToast",
        "reactionPlane",
        "reactionFire",
        "createdAt",
        "updatedAt"
      ]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "In-app activity notification synced across both partners with independent read states.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "enum": ["deposit", "reaction", "milestone", "love_note"]
        },
        "actorKey": {
          "type": "string",
          "enum": ["A", "B", "system"]
        },
        "actorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "targetPartnerKey": {
          "type": "string",
          "enum": ["A", "B", "all"]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "amount": {
          "type": "number"
        },
        "contributionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "reactionEmoji": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "readByA": {
          "type": "boolean"
        },
        "readByB": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "type",
        "actorKey",
        "actorName",
        "targetPartnerKey",
        "title",
        "body",
        "readByA",
        "readByB",
        "createdAt",
        "updatedAt"
      ]
    },
    "PushSubscriptionRecord": {
      "title": "PushSubscriptionRecord",
      "description": "Web Push subscription registered by a partner device for OS/PWA notifications.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "partnerKey": {
          "type": "string",
          "enum": ["A", "B"]
        },
        "endpoint": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1000,
          "pattern": "^https://.+"
        },
        "p256dh": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "auth": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "deviceLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "notifyDeposits": {
          "type": "boolean"
        },
        "notifyReactions": {
          "type": "boolean"
        },
        "notifyMilestones": {
          "type": "boolean"
        },
        "notifyLoveNote": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "partnerKey",
        "endpoint",
        "p256dh",
        "auth",
        "deviceLabel",
        "notifyDeposits",
        "notifyReactions",
        "notifyMilestones",
        "notifyLoveNote",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/vaults/{vaultId}": {
      "schema": {
        "$ref": "#/entities/Vault"
      },
      "description": "Single shared couple Africa trip savings vault document."
    },
    "/vaults/{vaultId}/categories/{categoryId}": {
      "schema": {
        "$ref": "#/entities/Category"
      },
      "description": "Custom earning categories belonging to the vault."
    },
    "/vaults/{vaultId}/contributions/{contributionId}": {
      "schema": {
        "$ref": "#/entities/Contribution"
      },
      "description": "External-activity deposit records belonging to the vault."
    },
    "/vaults/{vaultId}/notifications/{notificationId}": {
      "schema": {
        "$ref": "#/entities/NotificationItem"
      },
      "description": "Synced couple activity notifications with per-partner read flags."
    },
    "/vaults/{vaultId}/pushSubscriptions/{subscriptionId}": {
      "schema": {
        "$ref": "#/entities/PushSubscriptionRecord"
      },
      "description": "Web Push subscriptions for couple devices."
    }
  }
}
