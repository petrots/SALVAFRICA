{
  "entities": {
    "Vault": {
      "title": "Vault",
      "description": "Single shared couple Africa trip savings vault with fixed completion target.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "destination": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "targetAmount": {
          "type": "number",
          "description": "Fixed completion goal in EUR."
        },
        "partnerAName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "partnerBName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "loveNote": {
          "type": "string",
          "maxLength": 240
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "title",
        "destination",
        "targetAmount",
        "partnerAName",
        "partnerBName",
        "loveNote",
        "createdAt",
        "updatedAt"
      ]
    },
    "Category": {
      "title": "Category",
      "description": "Customizable deposit category synced between both partners with archive and last-used support.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "archived": {
          "type": "boolean"
        },
        "lastUsedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Nullable timestamp of most recent deposit using this category."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "archived",
        "lastUsedAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "Contribution": {
      "title": "Contribution",
      "description": "Deposit funded strictly by external side activities.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "amount": {
          "type": "number"
        },
        "partnerKey": {
          "type": "string",
          "enum": ["A", "B"]
        },
        "partnerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "sourceTag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "categoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "note": {
          "type": "string",
          "maxLength": 200
        },
        "reactionHeart": {
          "type": "boolean"
        },
        "reactionToast": {
          "type": "boolean"
        },
        "reactionPlane": {
          "type": "boolean"
        },
        "reactionFire": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "amount",
        "partnerKey",
        "partnerName",
        "sourceTag",
        "note",
        "reactionHeart",
        "reactionToast",
        "reactionPlane",
        "reactionFire",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/vaults/{vaultId}": {
      "schema": {
        "$ref": "#/entities/Vault"
      },
      "description": "Single shared couple Africa trip savings vault document."
    },
    "/vaults/{vaultId}/categories/{categoryId}": {
      "schema": {
        "$ref": "#/entities/Category"
      },
      "description": "Custom earning categories belonging to the vault."
    },
    "/vaults/{vaultId}/contributions/{contributionId}": {
      "schema": {
        "$ref": "#/entities/Contribution"
      },
      "description": "External-activity deposit records belonging to the vault."
    }
  }
}
