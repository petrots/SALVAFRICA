rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all unspecified paths by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isMainVault(vaultId) {
      return isValidId(vaultId) && vaultId == 'salvafrica-viaggio';
    }

    function parentVaultExists(vaultId) {
      return exists(/databases/$(database)/documents/vaults/$(vaultId));
    }

    function isValidVault(data) {
      return data.keys().hasAll([
          'id', 'title', 'destination', 'targetAmount',
          'partnerAName', 'partnerBName', 'loveNote',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'title', 'destination', 'targetAmount',
          'partnerAName', 'partnerBName', 'loveNote',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id.size() <= 64
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 80
        && data.destination is string && data.destination.size() >= 1 && data.destination.size() <= 80
        && data.targetAmount is number && data.targetAmount > 0 && data.targetAmount <= 1000000
        && data.partnerAName is string && data.partnerAName.size() >= 1 && data.partnerAName.size() <= 40
        && data.partnerBName is string && data.partnerBName.size() >= 1 && data.partnerBName.size() <= 40
        && data.loveNote is string && data.loveNote.size() <= 240
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCategory(data) {
      return data.keys().hasAll([
          'id', 'name', 'archived', 'lastUsedAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'archived', 'lastUsedAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id.size() <= 64
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 50
        && data.archived is bool
        && (data.lastUsedAt == null || data.lastUsedAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidContribution(data) {
      return data.keys().hasAll([
          'id', 'amount', 'partnerKey', 'partnerName', 'sourceTag', 'note',
          'reactionHeart', 'reactionToast', 'reactionPlane', 'reactionFire',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'amount', 'partnerKey', 'partnerName', 'sourceTag', 'categoryId', 'note',
          'pendingPhysical', 'reactionHeart', 'reactionToast', 'reactionPlane', 'reactionFire',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id) && data.id.size() <= 64
        && data.amount is number && data.amount > 0 && data.amount <= 100000
        && data.partnerKey is string && (data.partnerKey == 'A' || data.partnerKey == 'B')
        && data.partnerName is string && data.partnerName.size() >= 1 && data.partnerName.size() <= 40
        && data.sourceTag is string && data.sourceTag.size() >= 1 && data.sourceTag.size() <= 50
        && (!('categoryId' in data) || (isValidId(data.categoryId) && data.categoryId.size() <= 64))
        && data.note is string && data.note.size() <= 200
        && (!('pendingPhysical' in data) || data.pendingPhysical is bool)
        && data.reactionHeart is bool
        && data.reactionToast is bool
        && data.reactionPlane is bool
        && data.reactionFire is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll([
          'id', 'type', 'actorKey', 'actorName', 'targetPartnerKey',
          'title', 'body', 'readByA', 'readByB', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'type', 'actorKey', 'actorName', 'targetPartnerKey',
          'title', 'body', 'amount', 'contributionId', 'reactionEmoji',
          'readByA', 'readByB', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id) && data.id.size() <= 64
        && data.type is string && (
          data.type == 'deposit' || data.type == 'reaction' || data.type == 'milestone' || data.type == 'love_note'
        )
        && data.actorKey is string && (data.actorKey == 'A' || data.actorKey == 'B' || data.actorKey == 'system')
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 40
        && data.targetPartnerKey is string && (
          data.targetPartnerKey == 'A' || data.targetPartnerKey == 'B' || data.targetPartnerKey == 'all'
        )
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 100
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 240
        && (!('amount' in data) || (data.amount is number && data.amount > 0 && data.amount <= 100000))
        && (!('contributionId' in data) || (isValidId(data.contributionId) && data.contributionId.size() <= 64))
        && (!('reactionEmoji' in data) || (data.reactionEmoji is string && data.reactionEmoji.size() >= 1 && data.reactionEmoji.size() <= 16))
        && data.readByA is bool
        && data.readByB is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPushSubscription(data) {
      return data.keys().hasAll([
          'id', 'partnerKey', 'endpoint', 'p256dh', 'auth', 'deviceLabel',
          'notifyDeposits', 'notifyReactions', 'notifyMilestones', 'notifyLoveNote',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'partnerKey', 'endpoint', 'p256dh', 'auth', 'deviceLabel',
          'notifyDeposits', 'notifyReactions', 'notifyMilestones', 'notifyLoveNote',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id) && data.id.size() <= 64
        && data.partnerKey is string && (data.partnerKey == 'A' || data.partnerKey == 'B')
        && data.endpoint is string && data.endpoint.size() >= 10 && data.endpoint.size() <= 1000 && data.endpoint.matches('^https://.+')
        && data.p256dh is string && data.p256dh.size() >= 1 && data.p256dh.size() <= 256
        && data.auth is string && data.auth.size() >= 1 && data.auth.size() <= 128
        && data.deviceLabel is string && data.deviceLabel.size() >= 1 && data.deviceLabel.size() <= 80
        && data.notifyDeposits is bool
        && data.notifyReactions is bool
        && data.notifyMilestones is bool
        && data.notifyLoveNote is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /vaults/{vaultId} {
      allow get: if isMainVault(vaultId);
      allow list: if false;
      allow create: if isMainVault(vaultId)
        && isValidVault(incoming())
        && incoming().id == vaultId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isMainVault(vaultId)
        && isValidVault(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'destination', 'targetAmount', 'partnerAName', 'partnerBName', 'loveNote', 'updatedAt'
        ])
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if false;

      match /categories/{categoryId} {
        allow get: if isMainVault(vaultId) && isValidId(categoryId) && parentVaultExists(vaultId);
        allow list: if isMainVault(vaultId);
        allow create: if isMainVault(vaultId)
          && isValidId(categoryId)
          && isValidCategory(incoming())
          && incoming().id == categoryId
          && (incoming().lastUsedAt == null || incoming().lastUsedAt == request.time)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentVaultExists(vaultId);
        allow update: if isMainVault(vaultId)
          && isValidId(categoryId)
          && isValidCategory(incoming())
          && parentVaultExists(vaultId)
          && incoming().id == existing().id
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt'])
            ||
            incoming().diff(existing()).affectedKeys().hasOnly(['archived', 'updatedAt'])
            ||
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['lastUsedAt', 'updatedAt'])
              && incoming().lastUsedAt == request.time
            )
          );
        allow delete: if false;
      }

      match /contributions/{contributionId} {
        allow get: if isMainVault(vaultId) && isValidId(contributionId) && parentVaultExists(vaultId);
        allow list: if isMainVault(vaultId);
        allow create: if isMainVault(vaultId)
          && isValidId(contributionId)
          && isValidContribution(incoming())
          && incoming().id == contributionId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentVaultExists(vaultId);
        allow update: if isMainVault(vaultId)
          && isValidId(contributionId)
          && isValidContribution(incoming())
          && parentVaultExists(vaultId)
          && incoming().id == existing().id
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'reactionHeart', 'reactionToast', 'reactionPlane', 'reactionFire', 'updatedAt'
            ])
            ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'sourceTag', 'updatedAt'
            ])
            ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'pendingPhysical', 'updatedAt'
            ])
            ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'amount', 'partnerKey', 'partnerName', 'sourceTag', 'categoryId', 'note', 'pendingPhysical', 'updatedAt'
            ])
          );
        allow delete: if isMainVault(vaultId) && isValidId(contributionId) && parentVaultExists(vaultId);
      }

      match /notifications/{notificationId} {
        allow get: if isMainVault(vaultId) && isValidId(notificationId) && parentVaultExists(vaultId);
        allow list: if isMainVault(vaultId);
        allow create: if isMainVault(vaultId)
          && isValidId(notificationId)
          && isValidNotification(incoming())
          && incoming().id == notificationId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentVaultExists(vaultId);
        allow update: if isMainVault(vaultId)
          && isValidId(notificationId)
          && isValidNotification(incoming())
          && parentVaultExists(vaultId)
          && incoming().id == existing().id
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['readByA', 'updatedAt'])
            ||
            incoming().diff(existing()).affectedKeys().hasOnly(['readByB', 'updatedAt'])
            ||
            incoming().diff(existing()).affectedKeys().hasOnly(['readByA', 'readByB', 'updatedAt'])
          );
        allow delete: if isMainVault(vaultId) && isValidId(notificationId) && parentVaultExists(vaultId);
      }

      match /pushSubscriptions/{subscriptionId} {
        allow get: if isMainVault(vaultId) && isValidId(subscriptionId) && parentVaultExists(vaultId);
        allow list: if isMainVault(vaultId);
        allow create: if isMainVault(vaultId)
          && isValidId(subscriptionId)
          && isValidPushSubscription(incoming())
          && incoming().id == subscriptionId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentVaultExists(vaultId);
        allow update: if isMainVault(vaultId)
          && isValidId(subscriptionId)
          && isValidPushSubscription(incoming())
          && parentVaultExists(vaultId)
          && incoming().id == existing().id
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'partnerKey', 'notifyDeposits', 'notifyReactions', 'notifyMilestones', 'notifyLoveNote', 'deviceLabel', 'updatedAt'
            ])
            ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'endpoint', 'p256dh', 'auth', 'partnerKey', 'deviceLabel',
              'notifyDeposits', 'notifyReactions', 'notifyMilestones', 'notifyLoveNote', 'updatedAt'
            ])
          );
        allow delete: if isMainVault(vaultId) && isValidId(subscriptionId) && parentVaultExists(vaultId);
      }
    }
  }
}
