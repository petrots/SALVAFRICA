rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all unspecified paths by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isMainVault(vaultId) {
      return isValidId(vaultId) && vaultId == 'salvafrica-viaggio';
    }

    function parentVaultExists(vaultId) {
      return exists(/databases/$(database)/documents/vaults/$(vaultId));
    }

    function isValidVault(data) {
      return data.keys().hasAll([
          'id', 'title', 'destination', 'targetAmount',
          'partnerAName', 'partnerBName', 'loveNote',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'title', 'destination', 'targetAmount',
          'partnerAName', 'partnerBName', 'loveNote',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id.size() <= 64
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 80
        && data.destination is string && data.destination.size() >= 1 && data.destination.size() <= 80
        && data.targetAmount is number && data.targetAmount > 0 && data.targetAmount <= 1000000
        && data.partnerAName is string && data.partnerAName.size() >= 1 && data.partnerAName.size() <= 40
        && data.partnerBName is string && data.partnerBName.size() >= 1 && data.partnerBName.size() <= 40
        && data.loveNote is string && data.loveNote.size() <= 240
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidContribution(data) {
      return data.keys().hasAll([
          'id', 'amount', 'partnerKey', 'partnerName', 'sourceTag', 'note',
          'reactionHeart', 'reactionToast', 'reactionPlane', 'reactionFire',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'amount', 'partnerKey', 'partnerName', 'sourceTag', 'note',
          'reactionHeart', 'reactionToast', 'reactionPlane', 'reactionFire',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id) && data.id.size() <= 64
        && data.amount is number && data.amount > 0 && data.amount <= 100000
        && data.partnerKey is string && (data.partnerKey == 'A' || data.partnerKey == 'B')
        && data.partnerName is string && data.partnerName.size() >= 1 && data.partnerName.size() <= 40
        && data.sourceTag is string && data.sourceTag.size() >= 1 && data.sourceTag.size() <= 50
        && data.note is string && data.note.size() <= 200
        && data.reactionHeart is bool
        && data.reactionToast is bool
        && data.reactionPlane is bool
        && data.reactionFire is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /vaults/{vaultId} {
      allow get: if isMainVault(vaultId);
      allow list: if false;
      allow create: if isMainVault(vaultId)
        && isValidVault(incoming())
        && incoming().id == vaultId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isMainVault(vaultId)
        && isValidVault(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'destination', 'targetAmount', 'partnerAName', 'partnerBName', 'loveNote', 'updatedAt'
        ])
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if false;

      match /contributions/{contributionId} {
        allow get: if isMainVault(vaultId) && isValidId(contributionId) && parentVaultExists(vaultId);
        allow list: if isMainVault(vaultId);
        allow create: if isMainVault(vaultId)
          && isValidId(contributionId)
          && isValidContribution(incoming())
          && incoming().id == contributionId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentVaultExists(vaultId);
        allow update: if isMainVault(vaultId)
          && isValidId(contributionId)
          && isValidContribution(incoming())
          && parentVaultExists(vaultId)
          && incoming().id == existing().id
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'reactionHeart', 'reactionToast', 'reactionPlane', 'reactionFire', 'updatedAt'
            ])
            ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'amount', 'partnerKey', 'partnerName', 'sourceTag', 'note', 'updatedAt'
            ])
          );
        allow delete: if isMainVault(vaultId) && isValidId(contributionId) && parentVaultExists(vaultId);
      }
    }
  }
}
